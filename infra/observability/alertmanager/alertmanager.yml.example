# 이 파일을 alertmanager.yml로 복사한 뒤 chat_id를 채운다.
#   cp alertmanager.yml.example alertmanager.yml
# 실사용 파일은 .gitignore로 제외된다. Alertmanager 설정은 환경변수 치환을 지원하지 않으므로
# chat_id를 파일에 직접 적어야 하고, 그래서 커밋 대상에서 뺀다.

route:
  receiver: telegram
  # 같은 알림이 여러 인스턴스에서 와도 하나로 묶는다.
  group_by: [alertname, env]
  # 첫 알림 전 30초 대기하며 동시 발생 알림을 한 메시지로 모은다.
  group_wait: 30s
  # 이미 발화 중인 그룹에 새 알림이 추가될 때의 최소 간격.
  group_interval: 5m
  # 해소되지 않은 알림의 재통보 주기. 이 값이 없으면 텔레그램 폭탄을 맞는다.
  repeat_interval: 30m

  routes:
    # 생존 신호는 사람에게 보내지 않는다. 외부 데드맨 스위치를 붙일 때
    # 아래 null 대신 webhook 수신자로 바꾼다.
    - matchers:
        - alertname = "Watchdog"
      receiver: "null"
      repeat_interval: 1m

inhibit_rules:
  # exporter가 죽어 Redis 상태를 알 수 없는 동안에는 하위 warning을 억제한다.
  - source_matchers:
      - alertname = "RedisExporterDown"
    target_matchers:
      - severity = "warning"
    equal: [env]

receivers:
  - name: "null"

  - name: telegram
    telegram_configs:
      # 토큰은 secrets/telegram_token 파일에 한 줄로 넣는다(개행 포함 가능).
      # backend/.env의 TELEGRAM_BOT_TOKEN과 같은 봇을 써도 되고 별도 운영 봇을 파도 된다.
      - bot_token_file: /etc/alertmanager/secrets/telegram_token
        # ⚠️ 반드시 정수다. 따옴표를 씌우면 설정 로딩이 실패한다.
        #    그룹/채널은 -100으로 시작하는 음수다. 개인 DM은 양수.
        #    확인 방법은 README의 "chat_id 확인" 절 참조.
        chat_id: 0
        # ⚠️ 기본값에 맡기지 말 것. 알림 본문에 예외 메시지의 특수문자가 섞이면
        #    텔레그램이 400을 반환하며 알림이 통째로 사라진다.
        parse_mode: HTML
        send_resolved: true
        # 템플릿은 text/template이라 자동 이스케이프가 없다. 본문에 들어가는 값은
        # 반드시 html 필터를 통과시킨다. 이걸 빼면 <나 &가 섞이는 순간 발송이 실패한다.
        message: |
          {{ if eq .Status "firing" }}🚨{{ else }}✅{{ end }} <b>{{ .CommonLabels.alertname | html }}</b> [{{ .Status | toUpper }}]
          {{ range .Alerts }}
          {{ .Annotations.summary | html }}
          {{ .Annotations.description | html }}
          {{ end }}
